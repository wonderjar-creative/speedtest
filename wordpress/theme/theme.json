{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#0ea5e9"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#64748b"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#f97316"
        },
        {
          "slug": "black",
          "name": "Black",
          "color": "#000000"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        },
        {
          "slug": "gray-100",
          "name": "Gray 100",
          "color": "#f3f4f6"
        },
        {
          "slug": "gray-300",
          "name": "Gray 300",
          "color": "#d1d5db"
        },
        {
          "slug": "gray-500",
          "name": "Gray 500",
          "color": "#6b7280"
        },
        {
          "slug": "gray-900",
          "name": "Gray 900",
          "color": "#111827"
        }
      ],
      "gradients": [
        {
          "slug": "gradient-primary",
          "name": "Primary Gradient",
          "gradient": "linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%)"
        },
        {
          "slug": "gradient-accent",
          "name": "Accent Gradient",
          "gradient": "linear-gradient(135deg, #f97316 0%, #ef4444 100%)"
        }
      ]
    },
    "layout": {
      "contentSize": "900px",
      "wideSize": "1400px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "Tiny",
          "size": "10px",
          "slug": "20"
        },
        {
          "name": "X-Small",
          "size": "20px",
          "slug": "30"
        },
        {
          "name": "Small",
          "size": "30px",
          "slug": "40"
        },
        {
          "name": "Regular",
          "size": "clamp(30px, 5vw, 50px)",
          "slug": "50"
        },
        {
          "name": "Large",
          "size": "clamp(30px, 7vw, 70px)",
          "slug": "60"
        },
        {
          "name": "X-Large",
          "size": "clamp(50px, 7vw, 90px)",
          "slug": "70"
        },
        {
          "name": "XX-Large",
          "size": "clamp(70px, 10vw, 140px)",
          "slug": "80"
        }
      ],
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    },
    "typography": {
      "writingMode": true,
      "defaultFontSizes": false,
      "fluid": false,
      "fontSizes": [
        { "slug": "xs",   "name": "XS",   "size": "0.75rem" },
        { "slug": "sm",   "name": "SM",   "size": "0.875rem" },
        { "slug": "base", "name": "Base", "size": "clamp(0.875rem, calc(0.838rem + 0.185vw), 1rem)" },
        { "slug": "lg",   "name": "LG",   "size": "clamp(0.95rem, calc(0.913rem + 0.185vw), 1.125rem)" },
        { "slug": "xl",   "name": "XL",   "size": "clamp(1rem, calc(0.926rem + 0.37vw), 1.25rem)" },
        { "slug": "2xl",  "name": "2XL",  "size": "clamp(1.25rem, calc(1.176rem + 0.37vw), 1.5rem)" },
        { "slug": "3xl",  "name": "3XL",  "size": "clamp(1.5rem, calc(1.389rem + 0.556vw), 1.875rem)" },
        { "slug": "4xl",  "name": "4XL",  "size": "clamp(1.75rem, calc(1.602rem + 0.741vw), 2.25rem)" },
        { "slug": "5xl",  "name": "5XL",  "size": "clamp(2.25rem, calc(2.028rem + 1.111vw), 3rem)" },
        { "slug": "6xl",  "name": "6XL",  "size": "clamp(2.75rem, calc(2.454rem + 1.481vw), 3.75rem)" },
        { "slug": "7xl",  "name": "7XL",  "size": "clamp(3rem, calc(2.556rem + 2.222vw), 4.5rem)" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--gray-900)"
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|50",
        "right": "var:preset|spacing|50"
      }
    },
    "typography": {
      "fontFamily": "system-ui, -apple-system, sans-serif",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": { "radius": "0.375rem" },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--accent)" }
        }
      },
      "heading": {
        "color": { "text": "var(--wp--preset--color--gray-900)" },
        "typography": { "fontWeight": "700" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
