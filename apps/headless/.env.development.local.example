# WordPress API URLs and Credentials (DEVELOPMENT)
NEXT_PUBLIC_BASE_URL=http://wonderjarcreative.local
NEXT_PUBLIC_WORDPRESS_API_URL=https://cms.wonderjarcreative.com
NEXT_PUBLIC_WORDPRESS_API_HOSTNAME=cms.wonderjarcreative.com
HEADLESS_SECRET="your-development-headless-secret"
WP_USER=frontendUser
WP_APP_PASS="your-development-app-password"
WP_THEME="wonderjarcreative-backend"

# Gravity Forms API Credentials (DEVELOPMENT)
GRAVITY_FORMS_CONSUMER_KEY=your-development-consumer-key
GRAVITY_FORMS_CONSUMER_SECRET=your-development-consumer-secret

# reCAPTCHA v3 (DEVELOPMENT)
# Get keys from https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-development-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-development-recaptcha-v3-secret-key
# Optional: Score threshold (0.0-1.0, default 0.5). Lower = more permissive
# RECAPTCHA_SCORE_THRESHOLD=0.5

# Template Part Revalidation Time (in seconds)
TEMPLATE_PART_REVALIDATE=300

# Development: Bypass SSL verification
NODE_TLS_REJECT_UNAUTHORIZED=0