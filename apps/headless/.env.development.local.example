# WordPress API URLs and Credentials (DEVELOPMENT)
# Local Docker WordPress at localhost:8080
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WORDPRESS_API_URL=http://localhost:8080
NEXT_PUBLIC_WORDPRESS_API_HOSTNAME=localhost

# ISR Revalidation secret (generate with: openssl rand -hex 32)
# Must match the value in your WordPress wp-config.php
HEADLESS_SECRET="your-development-headless-secret"

# WordPress REST API credentials
# Create a user in WP Admin, then generate an Application Password
# (Users → your user → Application Passwords)
WP_USER=frontendUser
WP_APP_PASS="xxxx xxxx xxxx xxxx xxxx xxxx"

# WordPress Theme Name
WP_THEME="elevation-theme"

# Template Part Revalidation Time (in seconds)
TEMPLATE_PART_REVALIDATE=300

# Development: Bypass SSL verification (local Docker has no SSL)
NODE_TLS_REJECT_UNAUTHORIZED=0
