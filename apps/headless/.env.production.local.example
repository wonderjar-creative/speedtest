# WordPress API URLs and Credentials (PRODUCTION)
NEXT_PUBLIC_BASE_URL=https://wonderjarcreative.com
NEXT_PUBLIC_WORDPRESS_API_URL=https://cms.wonderjarcreative.com
NEXT_PUBLIC_WORDPRESS_API_HOSTNAME=cms.wonderjarcreative.com
HEADLESS_SECRET="your-production-headless-secret"
WP_USER=frontendUser
WP_APP_PASS="your-production-app-password"
WP_THEME="wonderjarcreative-backend"

# Gravity Forms API Credentials (PRODUCTION)
GRAVITY_FORMS_CONSUMER_KEY=your-production-consumer-key
GRAVITY_FORMS_CONSUMER_SECRET=your-production-consumer-secret

# reCAPTCHA v3 (PRODUCTION)
# Get keys from https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-production-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-production-recaptcha-v3-secret-key
# Optional: Score threshold (0.0-1.0, default 0.5). Lower = more permissive
# RECAPTCHA_SCORE_THRESHOLD=0.5

# Template Part Revalidation Time (in seconds)
TEMPLATE_PART_REVALIDATE=300

# Production: DO NOT bypass SSL verification
# NODE_TLS_REJECT_UNAUTHORIZED should NOT be set in production
