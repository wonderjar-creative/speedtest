{
  "name": "speedtest-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Speed Test POC - Marketing demo for Denver Headless",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:comparison": "npm -w @speedtest/comparison run dev",
    "dev:headless": "npm -w @speedtest/headless run dev",
    "build:comparison": "npm -w @speedtest/comparison run build",
    "build:headless": "npm -w @speedtest/headless run build",
    "lint": "npm -w @speedtest/comparison run lint && npm -w @speedtest/headless run lint"
  },
  "engines": {
    "node": ">=20"
  }
}
